@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body, html {
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }

    .container-fluid {
        flex: 1;
    }

    footer {
        background-color: #f1f1f1;
        color: #f1f1f1;
        text-align: center;
        padding: 10px 0;
        position: relative;
        bottom: 0;
        width: 100%;
    }

    .card {
        background-color: #2a2a40;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        margin-bottom: 20px;
        padding: 20px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        color: #ffffff; /* Yazı rengini beyaz yap */
    }
        .card .card-title {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .card .card-text {
            font-size: 1.8rem;
            font-weight: bold;
            margin: 0;
        }

        .card small {
            display: block;
            margin-top: 5px;
            color: #b3b3b3;
        }

    .header {
        background-color: #1e1e2d;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 1.5rem;
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 20px;
    }

    .chart-container {
        background-color: #2a2a40;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        height: 300px; /* Grafik alanına yeterli yükseklik verin */
    }
</style>

<div class="container-fluid">
    <!-- Başlık -->


    <!-- Kartlar -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card text-white" style="background-color: #4285f4;">
                <div class="card-body">
                    <h5 class="card-title">Traffic</h5>
                    <p class="card-text">350,897</p>
                    <small>+3.48% Since last month</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white" style="background-color: #34a853;">
                <div class="card-body">
                    <h5 class="card-title">New Users</h5>
                    <p class="card-text">2,356</p>
                    <small>-3.48% Since last week</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white" style="background-color: #fbbc05;">
                <div class="card-body">
                    <h5 class="card-title">Sales</h5>
                    <p class="card-text">924</p>
                    <small>-1.10% Since yesterday</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white" style="background-color: #ea4335;">
                <div class="card-body">
                    <h5 class="card-title">Performance</h5>
                    <p class="card-text">49.65%</p>
                    <small>+12% Since last month</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafikler -->
    <div class="row">
        <div class="col-lg-8">
            <div class="chart-container">
                <h5 class="card-title" style="color: #ffffff;">Sales Value</h5>
                <canvas id="salesChart" width="400" height="200"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-container">
                <h5 class="card-title" style="color: #ffffff;">Total Orders</h5>
                <canvas id="ordersChart" width="400" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Çizgili Grafik -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="chart-container">
                <h5 class="card-title" style="color: #ffffff;">Monthly Growth</h5>
                <canvas id="growthChart" width="400" height="200"></canvas>
            </div>
        </div>
    </div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Sales Chart
        var salesChartCtx = document.getElementById('salesChart').getContext('2d');
        var salesChart = new Chart(salesChartCtx, {
            type: 'line',
            data: {
                labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Sales Value',
                    data: [10000, 15000, 20000, 25000, 30000, 35000, 40000, 45000],
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    borderColor: '#4285f4',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: '#f1f1f1' }
                    }
                },
                scales: {
                    x: { ticks: { color: '#f1f1f1' } },
                    y: { ticks: { color: '#f1f1f1' } }
                }
            }
        });

        // Orders Chart
        var ordersChartCtx = document.getElementById('ordersChart').getContext('2d');
        var ordersChart = new Chart(ordersChartCtx, {
            type: 'bar',
            data: {
                labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Total Orders',
                    data: [15, 25, 20, 35, 40, 50, 45, 60],
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderColor: '#ea4335',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: '#ffffff' }  // Efsane kontrast için beyaz renk
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: '#ffffff'  // X eksenindeki sayıları beyaz yap
                        },
                        grid: {
                            color: '#444444'  // X ekseni çizgisi rengi
                        }
                    },
                    y: {
                        ticks: {
                            color: '#ffffff'  // Y eksenindeki sayıları beyaz yap
                        },
                        grid: {
                            color: '#444444'  // Y ekseni çizgisi rengi
                        }
                    }
                }
            }
        });
        // Growth Chart (Çizgili Grafik)
        var growthChartCtx = document.getElementById('growthChart').getContext('2d');
        var growthChart = new Chart(growthChartCtx, {
            type: 'line',
            data: {
                labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
                datasets: [{
                    label: 'Monthly Growth',
                    data: [5, 10, 6, 15, 12, 20, 18, 25, 23, 30, 28, 35],
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: '#4bc0c0',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: '#ffffff' }  // Efsane kontrast için beyaz renk
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: '#ffffff'  // X eksenindeki sayıları beyaz yap
                        },
                        grid: {
                            color: '#444444'  // X ekseni çizgisi rengi
                        }
                    },
                    y: {
                        ticks: {
                            color: '#ffffff'  // Y eksenindeki sayıları beyaz yap
                        },
                        grid: {
                            color: '#444444'  // Y ekseni çizgisi rengi
                        }
                    }
                }
            }
        });
    </script>
}
