@using System.Security.Claims
@{
    // Retrieve User ID from claims
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    var userId = userIdClaim?.Value;

    // Retrieve Role from claims
    var roleClaim = User.FindFirst(ClaimTypes.Role);
    var userRol = roleClaim?.Value;

    // Retrieve active modules from "Module" claims
    var activeModules = User.Claims
        .Where(c => c.Type == "Module")
        .Select(c => c.Value)
        .ToList();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Oto Vizyon</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/media.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f9;
            margin: 0;
            padding: 0;
            
        }

        .sidebar {
            min-height: 100vh;
            background-color: #f8f9fa; /* Beyaza yakın ama biraz daha kapalı ton */
            color: gray; /* Varsayılan yazı rengini gri yaptık */
            position: fixed;
            width: 250px;
            left: 0;
            transition: transform 0.3s ease;
            transform: translateX(0);
        }

       
        .sidebar.closed {
            transform: translateX(-100%); /* Yan menü kapandığında */
        }

            .sidebar a {
                color: gray; /* Linklerin yazı rengini gri yaptık */
                text-decoration: none;
                padding: 15px;
                display: block;
                transition: background-color 0.3s;
            }

                .sidebar a:hover {
                    background-color: #f0f0f0; /* Hover durumunda açık gri arka plan */
                }

        .content-wrapper {
            margin-left: 250px; /* Yan menü açıkken içerik genişliği */
            padding: 20px;
            padding-bottom: 60px; /* Footer için yeterli alt boşluk ekleyin */
            background-color: #f8f9fa;
            transition: margin-left 0.3s ease; /* Animasyon efekti için */
        }

        .content-wrapper.full-width {
            margin-left: 0; /* Yan menü kapatıldığında içerik genişliği */
        }

        media (max-width: 768px) {
            .sidebar {
                margin-left: -250px; /* Responsive sidebar */
            }

            .content-wrapper {
                margin-left: 0; /* Content takes full width */
            }
        }

        #toggleSidebar {
            transition: background-color 0.3s, color 0.3s;
        }

        #toggleSidebar:hover {
            background-color: #495057; /* Hover efekti için arka plan rengi */
            color: white; /* Hover durumunda metin rengi */
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            text-align: center;
            width: 100%; /* Tam genişlik kaplaması */
            position: fixed; /* Sabit pozisyondan çıkarıldı */
            bottom: 0;
        }

        .nav-item .collapse .nav-link {
            padding-left: 30px; /* İç içe menüyü biraz içeriden başlatmak için */
            color: gray; /* Alt menüdeki yazı rengini gri yapma */
        }

            .nav-item .collapse .nav-link:hover {
                background-color: #e9ecef; /* Hover durumda açık gri */
            }
    </style>
</head>
<body>

