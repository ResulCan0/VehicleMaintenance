@{
    var activeModules = ViewBag.ActiveModules as List<dynamic>; // Aktif modülleri dinamik olarak al
    var userId = Context.Session.GetString("UserId");
    var userRol = Context.Session.GetString("RoleName");// Kullanıcının oturum bilgisi
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Araç Bakım Sistemi</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f9;
        }

        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }

        #sidebar {
            min-width: 250px;
            max-width: 250px;
            background: #332;
            color: #fff;
            transition: all 0.3s;
            position: fixed;
            height: 100%;
        }

            #sidebar.active {
                margin-left: -250px;
            }

            #sidebar .sidebar-header {
                padding: 20px;
                background: #0056b3;
                text-align: center;
            }

            #sidebar ul.components {
                padding: 20px 0;
            }

            #sidebar ul li {
                padding: 10px;
                text-align: left;
            }

                #sidebar ul li a {
                    color: white;
                    padding: 10px;
                    display: block;
                    font-size: 16px;
                    text-decoration: none;
                }

                    #sidebar ul li a:hover {
                        background: #0056b3;
                    }

                #sidebar ul li.active > a, a[aria-expanded="true"] {
                    background: #6d7fcc;
                }

        #content {
            width: 100%;
            padding: 20px;
            min-height: 100vh;
            margin-left: 250px;
            transition: all 0.3s;
        }

            #content.active {
                margin-left: 0;
            }

        .btn-toggle {
            background: transparent;
            border: none;
            color: black;
            font-size: 1.5em;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            text-align: center;
            width: 100%;
            position: fixed;
            bottom: 0;
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <!-- Sidebar -->
        <!--developed by dümenyazilim-->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h3>Araç Bakım Sistemi</h3>
            </div>


            <ul class="list-unstyled components">
              @if (userRol == "ADMİN")
                {
                    <ul>
                        <li>
                            <a href="/Company/Index">Şirketler</a>
                        </li>
                        <li>
                            <a href="/Users/Index">Şirket Kullanıcıları</a>
                        </li>
                        <li>
                            <a href="/Brand/Index">Araç Marka</a>

                        </li>
                        <li>
                            <a href="/BrandModel/Index">Araç Model</a>
                        </li>
                        <li>
                            <a href="/Vehicle/Index">Şirket Araçları</a>
                        </li>
                        <li>
                            <a href="/VehicleMaintenances/Index">Araç Bakım</a>
                        </li>
                        <li>
                            <a href="/StockPart/Index">Parça Stok Durumu</a>
                        </li>
                    </ul>
                  
                }
                else
                {
                    @await Component.InvokeAsync("ActiveModules")
                }
                

                @* Kullanıcı oturum açma durumu kontrolü *@
                <li>
                    @if (string.IsNullOrEmpty(userId))
                    {
                        <a href="/Account/Login">Giriş Yap</a>
                    }
                    else
                    {
                        <a href="/Account/Logout">Çıkış Yap</a>
                    }
                </li>
            </ul>
        </nav>


        <!-- Page Content -->
        <div id="content">
            <button type="button" id="sidebarCollapse" class="btn-toggle">
                <i class="fas fa-bars"></i>
            </button>

            <main role="main" class="container mt-4">
                @RenderBody()
                @RenderSection("Scripts", required: false)
            </main>

            <footer class="footer">
                <div class="container">
                    <span class="text-muted">
                        © 2024 Araç Bakım Sistemi
                        Helm Software tarafından geliştirildi
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
            });
        });
   
        async function getUserId() {
            try {
                const response = await fetch('/Company/GetUserId');
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                const userId = await response.text();
                if (!userId) {
                    console.error('UserId is null or empty');
                }
                return userId; 
            } catch (error) {
                console.error('Failed to fetch UserId:', error);
                return null; // Hata durumunda null döner
            }
        }

        document.addEventListener('click', async function (event) {
            var element = event.target;
            var elementId = element.id || "no-id";
            var elementText = element.innerText || "no-text";

            // Kullanıcı kimliğini sunucudan al
            var userId = await getUserId();

            var logData = {
                ElementId: elementId,
                ElementText: elementText,
                Timestamp: new Date().toISOString(),
                UserId: userId 
            };

            fetch('/Log/Click', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(logData)
            }).then(response => {
                if (response.ok) {
                    console.log('Developing By Dümen Yazilim');
                } else {
                    console.error('Developing By Dümen Yazilim Not');
                }
            });
        });



    </script>
</body>
</html>
