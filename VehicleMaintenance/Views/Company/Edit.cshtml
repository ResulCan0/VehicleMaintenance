@model Company
@{
    ViewData["Title"] = "Şirket Düzenle";
}
<h2>Şirket Düzenle</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="CompanyId" />

    <div class="form-group">
        <label asp-for="CompanyName" class="control-label">Şirket Adı</label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TaxNumber" class="control-label">VKN / TCKN</label>
        <input asp-for="TaxNumber" class="form-control" />
        <span asp-validation-for="TaxNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TaxOffice" class="control-label">Vergi Dairesi</label>
        <input asp-for="TaxOffice" class="form-control" />
        <span asp-validation-for="TaxOffice" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Adress" class="control-label">Adres</label>
        <input asp-for="Adress" class="form-control" />
        <span asp-validation-for="Adress" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber" class="control-label">Telefon Numarası</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Mail" class="control-label">E-Mail</label>
        <input asp-for="Mail" class="form-control" />
        <span asp-validation-for="Mail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PersonandLegal" class="control-label">Şirket Tipi</label>
        <select id="PersonandLegal" name="PersonandLegal" class="form-control">
            <option value="Seçiniz">Seçiniz</option>
            <option value="Şahıs">Şahıs</option>
            <option value="Tüzel">Tüzel</option>
        </select>
        <span asp-validation-for="PersonandLegal" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="WorkingType" class="control-label">Çalışma Tipi</label>
        <select id="WorkingType" name="WorkingType" class="form-control">
            <option value="Seçiniz">Seçiniz</option>
            <option value="Cari">Cari</option>
            <option value="Diğer">Diğer</option>
        </select>
        <span asp-validation-for="WorkingType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MaturityDate" class="control-label">Firma Vade</label>
        <input asp-for="MaturityDate" class="form-control" />
        <span asp-validation-for="MaturityDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="IsActive" class="control-label d-inline">Aktif</label>
        <input asp-for="IsActive" class="form-check-input d-inline custom-checkbox" />
        <span asp-validation-for="IsActive" class="text-danger"></span>
    </div>


    <div class="form-group">
        <input type="submit" value="Kaydet" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Listeye Geri Dön</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
