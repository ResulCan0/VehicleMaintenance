@model Application

<form id="editForm">
    @Html.AntiForgeryToken() <!-- CSRF koruması -->
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label for="SalesStatus">Satış Durumu</label>
        <select name="SalesStatus" class="form-control">
            <option value="Satıldı"v>Satıldı</option>
            <option value="Satılmadı">Satılmadı</option>
        </select>
    </div>
    <div class="form-group">
        <label for="Reason">Neden</label>
        <textarea name="Reason" class="form-control">@Model.Reason</textarea>
    </div>
    <button type="submit" class="btn btn-success">Kaydet</button>
</form>