@model Application

<h2>Satış Durumu Düzenle</h2>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label for="SalesStatus">Satış Durumu</label>
        <select asp-for="SalesStatus" class="form-control">
            <option value="Satıldı">Satıldı</option>
            <option value="Satılmadı">Satılmadı</option>
        </select>
    </div>
    <div class="form-group">
        <label for="Reason">Neden (Eğer satılmadıysa)</label>
        <textarea asp-for="Reason" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Kaydet</button>
</form>
