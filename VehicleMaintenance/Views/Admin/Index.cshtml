<table class="table table-striped">
    <thead>
        <tr>
            <th>Başvuru Tarihi</th>
            <th>Kullanıcı Adı</th>
            <th>Email</th>
            <th>Hizmetler</th>
            <th>Mesaj</th>
            <th>Satış Durumu</th>
            <th>Neden</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var application in Model.Applications)
        {
            <tr>
                <td>@application.ApplicationDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@application.Name</td>
                <td>@application.Email</td>
                <td>
                    <ul>
                        @if ((application.VehicleTracking ?? false))
                        {
                            <li>Araç Takip</li>
                        }
                        @if ((application.StockTracking ?? false))
                        {
                            <li>Stok Takip</li>
                        }
                        @if ((application.Ecommerce ?? false))
                        {
                            <li>E-Ticaret</li>
                        }
                        @if ((application.SeoOptimization ?? false))
                        {
                            <li>SEO Optimizasyonu</li>
                        }
                    </ul>
                </td>
                <td>@application.Message</td>
                <td>@application.SalesStatus</td>
                <td>@application.Reason</td>
                <td>
                    <a href="/Admin/Edit/@application.Id" class="btn btn-primary">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
