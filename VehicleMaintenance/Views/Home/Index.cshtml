        <script src="/js/jquery.magnific-popup.min.js"></script>
        <script src="/js/magnific-popup-options.js"></script>
        <script src="/js/custom.js"></script>
    <script>
        // Submit the form via AJAX
        document.getElementById('applyForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const formData = new FormData(this);
            const responseMessage = document.getElementById('responseMessage');

            try {
                const response = await fetch('/Home/Apply', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (result.success) {
                    responseMessage.innerHTML = '<p style="color: green;">' + result.message + '</p>';
                } else {
                    responseMessage.innerHTML = '<p style="color: red;">' + result.message + '</p>';
                }
            } catch (error) {
                responseMessage.innerHTML = '<p style="color: red;">Bir hata oluştu. Lütfen tekrar deneyin.</p>';
            }
        });
    </script>
